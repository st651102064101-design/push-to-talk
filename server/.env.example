# Generate unique values; never commit the real server/.env file.
PTT_USER_TOKEN=replace-with-at-least-32-random-characters
PTT_ADMIN_TOKEN=replace-with-a-different-32-character-token
PTT_DASHBOARD_USER=admin
PTT_DASHBOARD_PASSWORD=replace-with-at-least-16-random-characters
# Keep false outside Docker. Docker Compose overrides this because bridge networking
# hides localhost; Dashboard still requires Basic Authentication.
PTT_DASHBOARD_ALLOW_REMOTE=false
